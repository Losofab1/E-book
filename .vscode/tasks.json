{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend : démarrer automatiquement",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}\\PROJET_JAVA\\Biblioth"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*",
          "endsPattern": ".*Started .*"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "serveurs"
      }
    }
  ]
}
